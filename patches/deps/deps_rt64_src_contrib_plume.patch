     // VulkanSwapChain
 
+#   if defined(__PROSPERO__)
+    // The PS5's display, as PS5_VulkanTemplate's base/VulkanSwapChain.cpp and
+    // TheSimpsonsGame-PS5-Builder's vulkan_display_prospero.cpp find it on
+    // PS5_Mesa's VideoOut: a mode of the size asked (the display's own 3840x2160
+    // when none is), the one nearest 60 Hz, on a plane that shows it whole.
+    // The chosen size goes back into window.
+    static bool createProsperoDisplaySurface(VkInstance instance, VkPhysicalDevice physicalDevice,
+            RenderWindow &window, VkSurfaceKHR *surface) {
+        const uint32_t wantWidth = window.width ? window.width : 3840;
+        const uint32_t wantHeight = window.height ? window.height : 2160;
+        uint32_t displayCount = 0;
+        vkGetPhysicalDeviceDisplayPropertiesKHR(physicalDevice, &displayCount, nullptr);
+        std::vector<VkDisplayPropertiesKHR> displays(displayCount);
+        vkGetPhysicalDeviceDisplayPropertiesKHR(physicalDevice, &displayCount, displays.data());
+        displays.resize(displayCount);
+        uint32_t planeCount = 0;
+        vkGetPhysicalDeviceDisplayPlanePropertiesKHR(physicalDevice, &planeCount, nullptr);
+        std::vector<VkDisplayPlanePropertiesKHR> planes(planeCount);
+        vkGetPhysicalDeviceDisplayPlanePropertiesKHR(physicalDevice, &planeCount, planes.data());
+        planes.resize(planeCount);
+        if (displays.empty() || planes.empty()) {
+            fprintf(stderr, "PS5: the driver reports %u displays and %u planes.\n", displayCount, planeCount);
+            return false;
+        }
+
+        VkDisplayKHR display = VK_NULL_HANDLE;
+        VkDisplayModePropertiesKHR mode = {};
+        uint32_t bestDistance = UINT32_MAX;
+        for (const VkDisplayPropertiesKHR &properties : displays) {
+            uint32_t modeCount = 0;
+            vkGetDisplayModePropertiesKHR(physicalDevice, properties.display, &modeCount, nullptr);
+            std::vector<VkDisplayModePropertiesKHR> modes(modeCount);
+            vkGetDisplayModePropertiesKHR(physicalDevice, properties.display, &modeCount, modes.data());
+            modes.resize(modeCount);
+            for (const VkDisplayModePropertiesKHR &candidate : modes) {
+                const VkDisplayModeParametersKHR &p = candidate.parameters;
+                if ((p.visibleRegion.width != wantWidth) || (p.visibleRegion.height != wantHeight)) {
+                    continue;
+                }
+                const uint32_t distance = (p.refreshRate > 60000) ? (p.refreshRate - 60000) : (60000 - p.refreshRate);
+                if (distance < bestDistance) {
+                    bestDistance = distance;
+                    display = properties.display;
+                    mode = candidate;
+                }
+            }
+        }
+        if (display == VK_NULL_HANDLE) {
+            fprintf(stderr, "PS5: no %ux%u display mode.\n", wantWidth, wantHeight);
+            return false;
+        }
+
+        for (uint32_t planeIndex = 0; planeIndex < planeCount; planeIndex++) {
+            if ((planes[planeIndex].currentDisplay != VK_NULL_HANDLE) && (planes[planeIndex].currentDisplay != display)) {
+                continue;
+            }
+            uint32_t supportedCount = 0;
+            vkGetDisplayPlaneSupportedDisplaysKHR(physicalDevice, planeIndex, &supportedCount, nullptr);
+            std::vector<VkDisplayKHR> supported(supportedCount);
+            vkGetDisplayPlaneSupportedDisplaysKHR(physicalDevice, planeIndex, &supportedCount, supported.data());
+            supported.resize(supportedCount);
+            if (std::find(supported.begin(), supported.end(), display) == supported.end()) {
+                continue;
+            }
+            VkDisplayPlaneCapabilitiesKHR capabilities = {};
+            vkGetDisplayPlaneCapabilitiesKHR(physicalDevice, mode.displayMode, planeIndex, &capabilities);
+            VkDisplayPlaneAlphaFlagBitsKHR alpha = VK_DISPLAY_PLANE_ALPHA_OPAQUE_BIT_KHR;
+            if (!(capabilities.supportedAlpha & alpha)) {
+                if (capabilities.supportedAlpha & VK_DISPLAY_PLANE_ALPHA_GLOBAL_BIT_KHR) {
+                    alpha = VK_DISPLAY_PLANE_ALPHA_GLOBAL_BIT_KHR;
+                }
+                else if (capabilities.supportedAlpha & VK_DISPLAY_PLANE_ALPHA_PER_PIXEL_BIT_KHR) {
+                    alpha = VK_DISPLAY_PLANE_ALPHA_PER_PIXEL_BIT_KHR;
+                }
+                else if (capabilities.supportedAlpha & VK_DISPLAY_PLANE_ALPHA_PER_PIXEL_PREMULTIPLIED_BIT_KHR) {
+                    alpha = VK_DISPLAY_PLANE_ALPHA_PER_PIXEL_PREMULTIPLIED_BIT_KHR;
+                }
+            }
+            VkDisplaySurfaceCreateInfoKHR createInfo = {};
+            createInfo.sType = VK_STRUCTURE_TYPE_DISPLAY_SURFACE_CREATE_INFO_KHR;
+            createInfo.displayMode = mode.displayMode;
+            createInfo.planeIndex = planeIndex;
+            createInfo.planeStackIndex = planes[planeIndex].currentStackIndex;
+            createInfo.transform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+            createInfo.globalAlpha = 1.0f;
+            createInfo.alphaMode = alpha;
+            createInfo.imageExtent = mode.parameters.visibleRegion;
+            const VkResult res = vkCreateDisplayPlaneSurfaceKHR(instance, &createInfo, nullptr, surface);
+            if (res != VK_SUCCESS) {
+                fprintf(stderr, "vkCreateDisplayPlaneSurfaceKHR failed with error code 0x%X.\n", res);
+                return false;
+            }
+            window.width = mode.parameters.visibleRegion.width;
+            window.height = mode.parameters.visibleRegion.height;
+            fprintf(stderr, "PS5: display surface %ux%u at %u mHz, plane %u.\n", window.width, window.height,
+                mode.parameters.refreshRate, planeIndex);
+            return true;
+        }
+        fprintf(stderr, "PS5: no plane shows the %ux%u mode.\n", wantWidth, wantHeight);
+        return false;
+    }
+#   endif

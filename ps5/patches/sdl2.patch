diff --git a/src/filesystem/unix/SDL_sysfilesystem.c b/src/filesystem/unix/SDL_sysfilesystem.c
index 3f7533c..df73dc7 100644
--- a/src/filesystem/unix/SDL_sysfilesystem.c
+++ b/src/filesystem/unix/SDL_sysfilesystem.c
@@ -132,7 +132,15 @@ char *SDL_GetBasePath(void)
 {
     char *retval = NULL;
 
-#if defined(__FREEBSD__)
+#if defined(__PROSPERO__)
+    /* PlayStation 5: a title's own folder (/data/homebrew/<TITLE_ID>) is
+       mounted at /app0, and it is all of /data the title can see */
+    retval = SDL_strdup("/app0/");
+    if (!retval) {
+        SDL_OutOfMemory();
+    }
+    return retval;
+#elif defined(__FREEBSD__)
     char fullpath[PATH_MAX];
     size_t buflen = sizeof(fullpath);
     const int mib[] = { CTL_KERN, KERN_PROC, KERN_PROC_PATHNAME, -1 };
@@ -278,7 +286,12 @@ char *SDL_GetPrefPath(const char *org, const char *app)
      *
      * http://standards.freedesktop.org/basedir-spec/basedir-spec-latest.html
      */
+#ifdef __PROSPERO__
+    /* PlayStation 5: saves and settings in the title's own folder */
+    const char *envr = "/app0/userdata";
+#else
     const char *envr = SDL_getenv("XDG_DATA_HOME");
+#endif
     const char *append;
     char *retval = NULL;
     char *ptr = NULL;

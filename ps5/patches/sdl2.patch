diff --git a/CMakeLists.txt b/CMakeLists.txt
index e45b53e..dd7fcb0 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1469,6 +1469,31 @@ elseif(EMSCRIPTEN)
   CheckLibUnwind()
 
 elseif(UNIX AND NOT APPLE AND NOT RISCOS AND NOT HAIKU)
+  # The PlayStation 5 (the payload SDK's toolchain sets PS5): FreeBSD's
+  # threads, time and files, with the console's own video, audio and pad
+  # drivers (src/*/ps5, from SpaceRanger's ps5/sdl2). Their platform layer's
+  # header is in SDL_PS5_PLATFORM_DIR.
+  if(PS5)
+    if(NOT SDL_PS5_PLATFORM_DIR)
+      message(FATAL_ERROR "PS5: set SDL_PS5_PLATFORM_DIR (the platform layer's platform.h)")
+    endif()
+    include_directories("${SDL_PS5_PLATFORM_DIR}")
+    if(SDL_AUDIO)
+      set(SDL_AUDIO_DRIVER_PS5 1)
+      list(APPEND SOURCE_FILES ${SDL2_SOURCE_DIR}/src/audio/ps5/SDL_ps5audio.c)
+      set(HAVE_SDL_AUDIO TRUE)
+    endif()
+    if(SDL_JOYSTICK)
+      set(SDL_JOYSTICK_PS5 1)
+      list(APPEND SOURCE_FILES ${SDL2_SOURCE_DIR}/src/joystick/ps5/SDL_ps5joystick.c)
+      set(HAVE_SDL_JOYSTICK TRUE)
+    endif()
+    if(SDL_VIDEO)
+      set(SDL_VIDEO_DRIVER_PS5 1)
+      list(APPEND SOURCE_FILES ${SDL2_SOURCE_DIR}/src/video/ps5/SDL_ps5video.c)
+      set(HAVE_SDL_VIDEO TRUE)
+    endif()
+  endif()
   if(SDL_AUDIO)
     if(SYSV5 OR SOLARIS OR HPUX)
         # Newer Solaris-based systems, like OpenIndiana, don't have this interface anymore. Check for the header first.
